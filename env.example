# Copier ce fichier en .env avant le premier lancement : cp .env.example .env
# Identifiants d'une base LOCALE de formation : ne jamais réutiliser ces valeurs ailleurs.
# Mot de passe : uniquement des lettres, des chiffres et _ (les caractères @ : / % # ? cassent l'URL).

# Utilisés par le conteneur PostgreSQL
POSTGRES_USER=escale
POSTGRES_PASSWORD=escale_dev
POSTGRES_DB=escale

# Utilisée par Python. 127.0.0.1 plutôt que localhost (évite l'IPv6 sous Windows),
# port 5433 pour ne pas entrer en conflit avec un PostgreSQL installé sur le poste.
DATABASE_URL=postgresql+psycopg://escale:escale_dev@127.0.0.1:5433/escale
